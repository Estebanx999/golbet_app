@* GolBet.Web/Views/Error/NotFound.cshtml *@
@{
    ViewData["Title"] = "Página no encontrada";
}

<div class="text-center py-5">
    <h1 class="display-1">⚽ 404</h1>
    <h2>¡Ese balón se fue fuera de la cancha!</h2>
    <p class="text-muted mb-4">
        La página que buscas no existe o fue movida.
    </p>
    <a asp-controller="Matches" asp-action="Index" class="btn btn-success">
        Volver a la cartelera de partidos
    </a>
</div>
