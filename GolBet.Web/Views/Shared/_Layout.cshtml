<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GolBet</title>

    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Framework & Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GolBet.Web.styles.css" asp-append-version="true" />

    <style>
            :root {
                --bp-bg: #0b1019;
                --bp-header: #0e1b30;
                --bp-card: #152238;
                --bp-card-header: #1c2d4a;
                --bp-accent-lime: #00e676;
                --bp-accent-blue: #0088ff;
                --bp-text: #ffffff;
                --bp-text-muted: #8ca0ba;
                --bp-border: #1f3454;
            }

            body {
                font-family: 'Roboto', sans-serif;
                background-color: var(--bp-bg);
                color: var(--bp-text);
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                font-size: 0.9rem;
            }

            /* Navbar */
            .bp-navbar {
                background-color: var(--bp-header);
                border-bottom: 3px solid var(--bp-accent-lime);
                box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            }

            .navbar-brand {
                font-weight: 900;
                font-size: 1.6rem;
                letter-spacing: -0.5px;
            }

            .bp-nav-link {
                color: #8ca0ba !important;
                font-weight: 700;
                text-transform: uppercase;
                font-size: 0.85rem;
                padding: 0.5rem 0.8rem !important;
                border-radius: 4px;
                transition: all 0.2s ease-in-out;
            }

                .bp-nav-link:hover {
                    color: #fff !important;
                    background-color: rgba(255, 255, 255, 0.05);
                }

                /* Indicador de pestaña activa real */
                .bp-nav-link.active {
                    color: #fff !important;
                    background-color: rgba(255, 255, 255, 0.12) !important;
                    border-bottom: 2px solid var(--bp-accent-lime);
                }

            /* Buttons */
            .btn-bp-lime {
                background-color: var(--bp-accent-lime);
                color: #000;
                font-weight: 800;
                text-transform: uppercase;
                font-size: 0.8rem;
                border: none;
                padding: 0.5rem 1.2rem;
                border-radius: 4px;
                box-shadow: 0 0 10px rgba(0, 230, 118, 0.2);
                transition: all 0.2s;
            }

                .btn-bp-lime:hover {
                    background-color: #00c853;
                    color: #000;
                    box-shadow: 0 0 15px rgba(0, 230, 118, 0.5);
                }

            .btn-bp-login {
                color: #d1e0f0;
                font-weight: 700;
                font-size: 0.85rem;
                border: 1px solid var(--bp-border);
                background: transparent;
                text-transform: uppercase;
                padding: 0.45rem 1rem;
                border-radius: 4px;
                transition: all 0.2s;
            }

                .btn-bp-login:hover {
                    background: rgba(255, 255, 255, 0.08);
                    color: #fff;
                    border-color: #3a5885;
                }

            /* Footer */
            footer {
                background-color: var(--bp-header);
                border-top: 1px solid var(--bp-border);
                margin-top: auto;
            }
    </style>
</head>
<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bp-navbar py-1">
            <div class="container-fluid px-4">
                <a class="navbar-brand text-white d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-shaded text-warning fs-3"></i>
                    <span>GOL<span style="color: var(--bp-accent-lime);">BET</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto ms-3 gap-2 align-items-center">
                        <!-- INICIO -->
                        <li class="nav-item">
                            <a class="nav-link bp-nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill text-warning me-1"></i> Inicio
                            </a>
                        </li>

                        <!-- DEPORTES (Próximamente) -->
                        <li class="nav-item">
                            <a class="nav-link bp-nav-link d-flex flex-column align-items-center py-1 opacity-75" href="#" data-bs-toggle="modal" data-bs-target="#modalProximamente">
                                <span><i class="bi bi-trophy-fill text-warning me-1"></i> Deportes</span>
                                <span class="badge bg-secondary opacity-75" style="font-size: 0.55rem; padding: 2px 5px; line-height: 1;">PRÓXIMAMENTE</span>
                            </a>
                        </li>

                        <!-- PARTIDOS -->
                        <li class="nav-item">
                            <a class="nav-link bp-nav-link @(currentController == "Matches" ? "active" : "")" asp-controller="Matches" asp-action="Index">
                                <i class="bi bi-dribbble text-warning me-1"></i> Partidos
                            </a>
                        </li>

                        <!-- APUESTAS EN VIVO (Próximamente) -->
                        <li class="nav-item">
                            <a class="nav-link bp-nav-link d-flex flex-column align-items-center py-1 opacity-75" href="#" data-bs-toggle="modal" data-bs-target="#modalProximamente">
                                <span><span class="badge bg-danger me-1">EN VIVO</span> Apuestas en Vivo</span>
                                <span class="badge bg-secondary opacity-75" style="font-size: 0.55rem; padding: 2px 5px; line-height: 1;">PRÓXIMAMENTE</span>
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <a class="btn btn-sm btn-bp-login" asp-controller="Account" asp-action="Login">Ingresar</a>
                        <a class="btn btn-sm btn-bp-lime" asp-controller="Account" asp-action="Register">REGISTRARSE</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 my-3">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Modal Informativo Próximamente -->
    <div class="modal fade" id="modalProximamente" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-white" style="background-color: var(--bp-card); border: 1px solid var(--bp-border);">
                <div class="modal-header" style="border-bottom: 1px solid var(--bp-border);">
                    <h5 class="modal-title fw-bold"><i class="bi bi-clock-history text-warning me-2"></i>Módulo en Desarrollo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-rocket-takeoff text-success fs-1 d-block mb-3"></i>
                    <h4 class="fw-bold">¡Próximamente disponible!</h4>
                    <p class="text-muted small mb-0">Estamos trabajando para traerte más deportes y apuestas en tiempo real. Por ahora, disfruta de nuestra cartelera de partidos de fútbol.</p>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--bp-border);">
                    <button type="button" class="btn btn-sm btn-bp-lime w-100" data-bs-dismiss="modal">ENTENDIDO</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="py-3 text-center">
        <div class="container-fluid px-4 text-muted small">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start">
                    &copy; @DateTime.Now.Year <strong class="text-white">GolBet</strong> · Casa de Apuestas Oficial
                </div>
                <div class="col-md-6 text-md-end">
                    <a href="#" class="text-muted text-decoration-none me-3">Términos</a>
                    <a href="#" class="text-muted text-decoration-none">Juego Responsable <i class="bi bi-shield-check text-success"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>