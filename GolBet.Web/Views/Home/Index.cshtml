@{
    ViewData["Title"] = "Bienvenido a GolBet";
}

<style>
    /* Banner Principal GolBet (Estilo Hero) */
    .golbet-hero-banner {
        background: linear-gradient(rgba(10, 20, 38, 0.65), rgba(10, 20, 38, 0.90)), 
                    url('/images/fondo-estadio.jpg') no-repeat center center;
        background-size: cover;
        padding: 80px 20px;
        border-radius: 12px;
        border: 1px solid #1f3454;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    }

    .golbet-logo-icon {
        font-size: 4.5rem;
        color: #ffffff;
        filter: drop-shadow(0px 4px 12px rgba(0, 230, 118, 0.5));
    }

    .golbet-title {
        font-size: 3.8rem;
        font-weight: 900;
        letter-spacing: 3px;
        margin: 0;
        text-transform: uppercase;
        color: #ffffff;
        text-shadow: 2px 4px 12px rgba(0, 0, 0, 0.8);
    }

    .golbet-title span {
        color: #00e676; /* Verde GolBet */
    }

    .golbet-slogan {
        font-size: 1.4rem;
        font-weight: 300;
        font-style: italic;
        color: #c0d1e5;
        margin-top: 10px;
        text-shadow: 1px 2px 4px rgba(0, 0, 0, 0.8);
    }

    .feature-card {
        background-color: #152238;
        border: 1px solid #1f3454;
        border-radius: 8px;
        padding: 24px;
        transition: transform 0.2s, border-color 0.2s;
    }

    .feature-card:hover {
        transform: translateY(-4px);
        border-color: #00e676;
    }

    .feature-icon {
        font-size: 2rem;
        color: #00e676;
    }
</style>

<!-- BIENVENIDA GOLBET -->
<div class="golbet-hero-banner text-center my-4">
    <div class="mb-3">
        <i class="bi bi-dribbble golbet-logo-icon"></i>
    </div>
    <h1 class="golbet-title">Gol<span>Bet</span></h1>
    <p class="golbet-slogan">Siente la pasión, vive la jugada</p>
    
    <div class="mt-4">
        <a class="btn btn-success btn-lg px-4 fw-bold me-2" asp-controller="Matches" asp-action="Index">
            Explorar Partidos
        </a>
    </div>
</div>

<!-- SECCIÓN INFORMATIVA DE LA APP -->
<div class="row g-4 my-2">
    <div class="col-md-4">
        <div class="feature-card text-center">
            <i class="bi bi-trophy feature-icon mb-3"></i>
            <h5 class="text-white fw-bold">Las Mejores Ligas</h5>
            <p class="text-muted small mb-0">Sigue de cerca los eventos de la Champions League, LaLiga y más.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card text-center">
            <i class="bi bi-lightning-charge feature-icon mb-3"></i>
            <h5 class="text-white fw-bold">Resultados en Tiempo Real</h5>
            <p class="text-muted small mb-0">Consulta la información actualizada de cada encuentro al instante.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card text-center">
            <i class="bi bi-shield-check feature-icon mb-3"></i>
            <h5 class="text-white fw-bold">Plataforma Segura</h5>
            <p class="text-muted small mb-0">Disfruta de una experiencia de navegación fluida, rápida y confiable.</p>
        </div>
    </div>
</div>