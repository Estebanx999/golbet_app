@* Views/Teams/Index.cshtml *@ 
@model IEnumerable<GolBet.Services.DTOs.TeamDto> 
@{ 
    ViewData["Title"] = "Equipos"; 
} 

<div class="d-flex justify-content-between align-items-center mb-4"> 
    <h2 class="text-white fw-bold">Equipos</h2> 
    <a asp-action="Create" class="btn btn-success fw-semibold">+ Nuevo equipo</a> 
</div> 

<div class="table-responsive">
    <table class="table table-dark table-hover align-middle"> 
        <thead> 
            <tr class="text-secondary border-bottom border-dark-subtle"> 
                <th style="width: 60px"></th>
                <th>Nombre</th>
                <th>Ciudad</th>
                <th class="text-end">Acciones</th> 
            </tr> 
        </thead> 
        <tbody> 
        @foreach (var team in Model) 
        { 
            <tr> 
                <td> 
                    <img src="@(team.CrestUrl ?? "https://placehold.co/40x40/e9ecef/6c757d?text=FC")" 
                         width="40" height="40" class="rounded" alt="@team.Name" /> 
                </td> 
                <td class="fw-bold text-white">@team.Name</td> 
                <td class="text-light">@team.City</td> 
                <td class="text-end"> 
                    <a asp-action="Edit" asp-route-id="@team.Id" 
                       class="btn btn-sm btn-outline-primary me-1">Editar</a> 
                    <form asp-action="Deactivate" asp-route-id="@team.Id" method="post" 
                          class="d-inline" 
                          onsubmit="return confirm('¿Desactivar el equipo @team.Name?');"> 
                        <button type="submit" class="btn btn-sm btn-outline-danger"> 
                            Desactivar 
                        </button> 
                    </form> 
                </td> 
            </tr> 
        } 
        </tbody> 
    </table> 
</div>